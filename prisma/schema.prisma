generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model sagas {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(255)
  descricao String?  @db.Text
  livros    livros[]

  @@map("sagas")
}

model livros {
  id                   Int                    @id @default(autoincrement())
  titulo               String                 @db.VarChar(255)
  sinopse              String?                @db.Text
  data_publicacao      DateTime?              @db.Date
  ordem_serie          Int?
  saga_id              Int?
  capitulos            capitulos[]
  saga                 sagas?                 @relation(fields: [saga_id], references: [id])
  personagem_formas    personagem_forma[]
  personagemHistoricos personagem_historico[]

  @@index([saga_id], map: "livros_saga_id_fkey")
  @@map("livros")
}

model capitulos {
  id                        Int                    @id @default(autoincrement())
  livro_id                  Int
  parent_id                 Int?
  numero                    Int
  titulo                    String
  personagens_participantes Json?
  formas_participantes      Json?
  itens_participantes       Json?
  locais_participantes      Json?
  conteudo_json             Json?
  livros                    livros                 @relation(fields: [livro_id], references: [id], onDelete: Cascade)
  parent                    capitulos?             @relation("SubCapitulos", fields: [parent_id], references: [id], onDelete: Cascade)
  children                  capitulos[]            @relation("SubCapitulos")
  personagem_formas         personagem_forma[]
  personagemHistoricos      personagem_historico[]

  @@index([livro_id], map: "livro_id")
  @@index([parent_id], map: "parent_id")
  @@map("capitulos")
}

model locais {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(255)
  mundo     String   @db.VarChar(255)
  descricao String?  @db.Text
  imagem    String?
  criado_em DateTime @default(now())

  @@map("locais")
}

model personagens {
  id                  Int                    @id @default(autoincrement())
  nome                String
  titulo              String?
  mundo_origem        String?
  classe              String?
  afiliacao           String?
  altura              String?
  peso                String?
  tipo_corporal       String?
  tipo_cabelo         String?
  cor_cabelo          String?
  olhos               String?
  olhos_especiais     String?
  tom_voz             String?
  traje_combate       String?                @db.Text
  traje_casual        String?                @db.Text
  armamento_principal String?
  virtude             String?
  defeito             String?
  temperamento        String?
  imagemCorpo         String?
  imagemRosto         String?
  criado_em           DateTime               @default(now())
  atualizado_em       DateTime               @updatedAt
  formas              personagem_forma[]
  historicos          personagem_historico[]

  @@map("personagens")
}

model personagem_historico {
  id                    Int                @id @default(autoincrement())
  personagem_id         Int
  livro_id              Int?
  capitulo_id           Int?
  idade                 String?
  titulo                String?
  raca_id               Int
  ranque                String?
  subnivel              Int                @default(1)
  classificacao         String?
  nivel                 Int                @default(1)
  xpAtual               Int                @default(0)
  xpProximo             Int                @default(100)
  qtd_treino            Int                @default(0)
  ponto_combate         Int                @default(0)
  ponto_combateAetheris Int                @default(0)
  bonusPCErion          Int                @default(0)
  classes               String?
  estilo_luta           String?
  maestria              String?
  elementos             Json?
  equipamento           Json?
  habilidades           Json?
  formas_desbloqueadas  Json?
  criado_em             DateTime           @default(now())
  inventario            inventarios[]
  personagem_formas     personagem_forma[]
  capitulo              capitulos?         @relation(fields: [capitulo_id], references: [id])
  livro                 livros?            @relation(fields: [livro_id], references: [id])
  personagem            personagens        @relation(fields: [personagem_id], references: [id], onDelete: Cascade)
  raca                  racas              @relation(fields: [raca_id], references: [id])

  @@index([personagem_id])
  @@index([capitulo_id], map: "personagem_historico_capitulo_id_fkey")
  @@index([livro_id], map: "personagem_historico_livro_id_fkey")
  @@index([raca_id], map: "personagem_historico_raca_id_fkey")
  @@map("personagem_historico")
}

model personagem_forma {
  id                     Int                   @id @default(autoincrement())
  personagem_id          Int                   @map("personagem_id")
  sistema_id             Int                   @map("sistema_id")
  nome                   String
  descricao              String?               @db.Text
  ranque                 String?
  subnivel               Int                   @default(1)
  bonusPC                Float                 @default(0) @map("bonus_pc")
  pcForma                Int?                  @map("pc_forma")
  imagemRosto            String?               @map("imagem_rosto")
  imagemCorpo            String?               @map("imagem_corpo")
  criado_em              DateTime              @default(now())
  atualizado_em          DateTime              @updatedAt
  livrosId               Int?
  capitulosId            Int?
  personagem_historicoId Int?
  capitulos              capitulos?            @relation(fields: [capitulosId], references: [id])
  livros                 livros?               @relation(fields: [livrosId], references: [id])
  personagem_historico   personagem_historico? @relation(fields: [personagem_historicoId], references: [id])
  personagem             personagens           @relation(fields: [personagem_id], references: [id], onDelete: Cascade)
  sistema                sistemas              @relation(fields: [sistema_id], references: [id])

  @@index([personagem_id])
  @@index([sistema_id])
  @@index([capitulosId], map: "personagem_formas_capitulosId_fkey")
  @@index([livrosId], map: "personagem_formas_livrosId_fkey")
  @@index([personagem_historicoId], map: "personagem_formas_personagem_historicoId_fkey")
  @@map("personagem_formas")
}

model inventarios {
  id           Int                  @id @default(autoincrement())
  historico_id Int
  nome         String               @db.VarChar(255)
  descricao    String?              @db.Text
  tipo         String?              @db.VarChar(100)
  subtipo      String?              @db.VarChar(100)
  quantidade   Decimal              @default(0.00) @db.Decimal(18, 2)
  itensId_item Int?
  historico    personagem_historico @relation(fields: [historico_id], references: [id], onDelete: Cascade)
  itens        itens?               @relation(fields: [itensId_item], references: [id_item])

  @@index([historico_id], map: "inventarios_historico_id_fkey")
  @@index([itensId_item], map: "inventarios_itensId_item_fkey")
  @@map("inventarios")
}

model sistemas {
  id               Int                @id @default(autoincrement())
  nome             String             @unique
  progressao       Json
  limite_bonus     Json
  criado_em        DateTime           @default(now())
  atualizado_em    DateTime           @updatedAt
  personagemFormas personagem_forma[]
  racas            racas[]

  @@map("sistemas")
}

model racas {
  id         Int                    @id @default(autoincrement())
  nome       String                 @db.VarChar(80)
  base       Int
  limite     Int
  mundo      String                 @default("Geral") @db.VarChar(80)
  sistema_id Int
  criado_em  DateTime               @default(now())
  historicos personagem_historico[]
  sistema    sistemas               @relation(fields: [sistema_id], references: [id])

  @@index([sistema_id], map: "racas_sistema_id_fkey")
  @@map("racas")
}

model usuarios {
  id_usuario   Int       @id @default(autoincrement())
  login        String    @unique(map: "login") @db.VarChar(100)
  senha        String    @db.VarChar(255)
  nivel_acesso Int       @default(1)
  data_criacao DateTime? @default(now()) @db.Timestamp(0)

  @@map("usuarios")
}

model itens {
  id_item          Int           @id @default(autoincrement())
  nome             String        @db.VarChar(100)
  tipo             String        @db.VarChar(80)
  descricao        String?       @db.Text
  aparencia        String?       @db.Text
  listaHabilidades Json
  urlImagem        String?       @db.VarChar(255)
  usuarios         Json
  createdAt        DateTime      @default(now())
  inventarios      inventarios[]

  @@map("itens")
}
